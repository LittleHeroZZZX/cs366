{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug train",
      "type": "debugpy",
      "request": "launch",
      "program": "cli.py",
      "console": "integratedTerminal",
      "args": ["train-model", "${command:pickArgs}"]
    },
    {
      "type": "lldb-dap",
      "request": "launch",
      "name": "LLDB: Debug current python file",
      "program": "${workspaceRoot}/.venv/bin/python",
      "args": ["${workspaceRoot}/mytests/test_profile.py"],
      "env": ["EXTRA_CLING_ARGS=-g"],
      "cwd": "${workspaceRoot}"
    },
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },

    {
      "name": "Python Debugger: Module",
      "type": "debugpy",
      "request": "launch",
      "module": "src.${fileDirnameBasename}.${fileBasenameNoExtension}"
    }
  ]
}
